# Douyin Live AI Clipper 环境变量配置

# 必填：从浏览器开发者工具复制 Cookie 字符串（包含 sessionid, ttwid 等）
DY_LIVE_COOKIES=sessionid=xxx; sessionid_ss=xxx; sid_tt=xxx; ttwid=xxx; passport_csrf_token=xxx

# 可选：HuggingFace 镜像（中国大陆用户建议配置）
HF_ENDPOINT=https://hf-mirror.com

# 可选：模型下载缓存目录（避免重复下载）
# TRANSFORMERS_CACHE=./models
# HF_HOME=./models
